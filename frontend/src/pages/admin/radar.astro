---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

const currentPath = Astro.url.pathname;

// URL del frontend de Radar (Vercel en producción, Vite proxy en local)
const RADAR_URL = import.meta.env.PUBLIC_RADAR_URL || 'http://localhost:5174';

// ── SSO embebido ────────────────────────────────────────────
// El middleware YA validó la sesión del CRM (si no, redirige a /login).
// Obtenemos un token del Radar pasando la cookie de sesión que el
// middleware validó — el backend del portfolio la acepta en el header.
let radarToken: string | null = null;
try {
  const sessionCookie = Astro.cookies.get('access_token')?.value;
  if (sessionCookie) {
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
    const res = await fetch(`${apiBase}/api/v1/radar/token`, {
      // Pasamos el JWT directamente en Authorization — el backend lo valida
      // contra authCore igual que la cookie, y es más robusto que el header Cookie.
      headers: { Authorization: `Bearer ${sessionCookie}` },
      signal: AbortSignal.timeout(8000),
    });
    if (res.ok) {
      const data = await res.json();
      radarToken = data.token ?? null;
    } else {
      console.error(`[radar.astro] token endpoint HTTP ${res.status}`);
    }
  }
} catch (err) {
  console.error('[radar.astro] Error obteniendo token del Radar:', err);
}
---

<AdminLayout title="Radar — WhatsApp" currentPath={currentPath}>
  <div class="h-[calc(100vh-5rem)] w-full rounded-xl overflow-hidden border border-zinc-800">
    <iframe
      id="radar-frame"
      src={RADAR_URL}
      class="w-full h-full bg-white"
      title="Radar — Asistente WhatsApp"
      allow="camera; microphone"
    />
  </div>
</AdminLayout>

<script define:vars={{ radarToken }}>
  // ── SSO embebido: pasar el token al iframe por postMessage ──
  const frame = document.getElementById('radar-frame') as HTMLIFrameElement | null;

  if (frame && radarToken) {
    frame.addEventListener('load', () => {
      if (frame.contentWindow) {
        frame.contentWindow.postMessage(
          { type: 'radar-auth', token: radarToken },
          '*',
        );
      }
    });
  }
</script>
